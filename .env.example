# ==========================================
# SUBSIGHT Environment Configuration Template
# ==========================================

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-replace-with-a-cryptographically-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in production; SQLite when unset locally)
DB_ENGINE=postgresql
POSTGRES_DB=subsight
POSTGRES_USER=subsight_user
POSTGRES_PASSWORD=subsight_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery Message Broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# JWT Token Lifespans (Minutes & Days)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Environment (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
